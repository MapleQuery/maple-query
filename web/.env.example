# Server-only (read by app/api/mq/[...path]/route.ts, never sent to the
# browser). Do NOT prefix these with NEXT_PUBLIC_: that inlines them into
# the client bundle.
#
# Cloud Run agent-service URL (no trailing slash).
MAPLEQUERY_API_BASE_URL=https://agent-service-f2ihvaiw6q-uc.a.run.app
# Bearer token — from GCP Secret Manager:
#   gcloud secrets versions access latest --secret=mqagent-api-token --project=maplequery
MAPLEQUERY_API_TOKEN=

# Env label (public, not a secret). Vercel auto-injects VERCEL_ENV; this
# is a manual override for local dev.
NEXT_PUBLIC_MAPLEQUERY_ENV=dev
